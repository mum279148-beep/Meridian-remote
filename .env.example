# APP_URL: The public base URL where this application is hosted.
APP_URL="http://localhost:3000"

# Supabase Client Configuration (Public anon key only — safe for client bundle)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server-Side Configuration (NEVER expose to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Server-Side Session Signing Secret (used when running standalone Node/local auth mode)
MERIDIAN_AUTH_SECRET="replace-with-a-long-random-secret"

# RustDesk Self-Hosted / Pro Relay Configuration (Public relay details + server-only API key)
RUSTDESK_HBBS_HOST="rustdesk.your-domain.com"
RUSTDESK_HBBR_HOST="relay.your-domain.com"
RUSTDESK_PUBLIC_KEY="your-rustdesk-id-server-public-key"
RUSTDESK_API_KEY="server-side-rustdesk-pro-api-key"
